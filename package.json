{
    "name": "bongbot-core",
    "version": "1.0.0",
    "description": "Shared core library for BongBot projects",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc && rm -rf dist/responses && cp -r src/responses dist/responses",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --json --coverage --outputFile=report.json --passWithNoTests --silent",
        "postinstall": "npm run build"
    },
    "peerDependencies": {
        "better-sqlite3": "^12.8.0",
        "discord.js": "^14.25.1"
    },
    "dependencies": {
        "ipaddr.js": "^2.3.0",
        "source-map-support": "^0.5.21"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.5.0",
        "better-sqlite3": "^12.8.0",
        "cross-env": "^10.1.0",
        "discord.js": "^14.25.1",
        "jest": "^30.2.0",
        "jest-junit": "^16.0.0",
        "msw": "^2.12.14",
        "ts-jest": "^29.4.6",
        "ts-jest-resolver": "^2.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
}
