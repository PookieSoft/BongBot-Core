{
    "name": "@pookiesoft/bongbot-core",
    "version": "1.0.0",
    "description": "Shared core library for BongBot projects",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime-logger": {
            "types": "./dist/loggers/node_logger.d.ts",
            "bun": "./dist/loggers/bun_logger.js",
            "node": "./dist/loggers/node_logger.js",
            "default": "./dist/loggers/node_logger.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "files": [
        "dist",
        "package.json"
    ],
    "scripts": {
        "build": "tsc && node -e \"import('fs').then(f=>f.cpSync('src/responses','dist/responses',{recursive:true,force:true}))\"",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --json --coverage --outputFile=report.json --passWithNoTests --silent",
        "postinstall": "npm run build || true",
        "_postinstall_note": "TODO: Remove postinstall once all dependent repos have migrated to @pookiesoft/bongbot-core from GitHub Packages"
    },
    "peerDependencies": {
        "better-sqlite3": "^12.8.0",
        "discord.js": "^14.26.4"
    },
    "peerDependenciesMeta": {
        "better-sqlite3": {
            "optional": true
        }
    },
    "dependencies": {
        "ipaddr.js": "^2.4.0",
        "source-map-support": "^0.5.21"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.5.2",
        "better-sqlite3": "^12.8.0",
        "bun-types": "^1.3.13",
        "cross-env": "^10.1.0",
        "jest": "^30.2.0",
        "jest-junit": "^17.0.0",
        "msw": "^2.14.2",
        "prettier": "^3.8.3",
        "ts-jest": "^29.4.6",
        "ts-jest-resolver": "^2.0.1",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3"
    }
}
